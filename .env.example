# Server
PORT=3000
NODE_ENV=production

# PostgreSQL (Render에서 자동 제공)
DATABASE_URL=postgresql://user:password@host:5432/mycom_v4

# JWT
JWT_SECRET=mycom-super-secret-key-change-this
JWT_EXPIRE=7d

# AI API (선택사항)
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Upload
UPLOAD_DIR=public/uploads
